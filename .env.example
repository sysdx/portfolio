# Nothing here is needed to run locally: `pnpm dev` works with no keys.
# Fill these in when you connect the real services.

# Public site URL, used for the sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Supabase (phase 2: replaces data/store.json)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never prefix with NEXT_PUBLIC_

# Set to "true" only after Supabase Auth protects /admin.
# Until then the admin area is blocked in production builds.
ADMIN_AUTH_READY=

# Optional: raises the GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# Agent integrations (phase 3)
KAGGLE_USERNAME=
KAGGLE_KEY=
ANTHROPIC_API_KEY=
